# Copier en .env (chmod 600) et remplir. Ne jamais commiter .env.
DB_HOST=127.0.0.1
DB_USER=homedashboard_app
DB_PASSWORD=
DB_NAME=homedashboard
# Générer avec : openssl rand -hex 48
JWT_SECRET=
# Durée de validité des jetons (format jsonwebtoken)
JWT_EXPIRES_IN=90d
PORT=3000
# 127.0.0.1 une fois derrière nginx ; 0.0.0.0 tant que l'app appelle le port 3000 en direct
LISTEN_HOST=0.0.0.0
# 1 derrière nginx (vraie IP client pour la limite de tentatives)
#TRUST_PROXY=1
# Origines web autorisées (inutile pour l'app mobile)
#CORS_ORIGIN=
